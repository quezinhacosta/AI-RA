# ==========================================
# SEGREDOS & VARIÁVEIS DE AMBIENTE (CRÍTICO)
# ==========================================
.env
.env.*
!.env.example
*.key
*.pem

# ==========================================
# DADOS LOCAIS DO UTILIZADOR / RUNTIME
# ==========================================
# Evita subir dados pessoais reais, mas mantém a pasta e o exemplo
data/*.json
data/*.tmp
!data/.gitkeep
!data/user_state.example.json

# Ficheiros temporários de escrita atómica do StorageService
*.tmp

# ==========================================
# AMBIENTES VIRTUAIS (VENV / CONDA / POETRY)
# ==========================================
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
pyvenv.cfg
pip-selfcheck.json
pip-log.txt

# ==========================================
# BYTECODE & CACHE PYTHON
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==========================================
# FLET / FLUTTER / BUILDS DESKTOP
# ==========================================
build/
dist/
*.spec
.flet/
flet/
flet-build/
*.app/
*.exe
*.deb
*.rpm
*.apk
*.aab

# ==========================================
# IDES, EDITORES & SISTEMA OPERACIONAL
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace

# JetBrains (PyCharm)
.idea/

# Sistema Operacional
.DS_Store
Thumbs.db
*.bak
*~
*.log